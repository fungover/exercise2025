{
  "uid": null,
  "title": "WildFly JVM & Server Metrics",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "JVM Uptime",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "base_jvm_uptime_seconds",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 3600, "color": "orange" },
              { "value": 86400, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Heap Usage %",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(base_memory_usedHeap_bytes / base_memory_maxHeap_bytes) * 100",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "orange" },
              { "value": 90, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "type": "graph",
      "title": "Thread Count Over Time",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "base_thread_count",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"]
  }
}
