{
  "uid": null,
  "title": "WildFly JVM & Server Metrics",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "JVM Uptime",
      "datasource": "prometheus",
      "targets": [
        { "expr": "base_jvm_uptime_seconds", "refId": "A" }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 3600, "color": "orange" },
              { "value": 86400, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Heap Usage %",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "(base_memory_usedHeap_bytes / base_memory_maxHeap_bytes) * 100",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "orange" },
              { "value": 90, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "type": "graph",
      "title": "Thread Count Over Time",
      "datasource": "prometheus",
      "targets": [
        { "expr": "base_thread_count", "refId": "A" }
      ],
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "type": "graph",
      "title": "HTTP Request Rate",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(wildfly_undertow_request_count_total[1m])", "refId": "A" }
      ],
      "gridPos": { "x": 0, "y": 9, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "req/s" } }
    },
    {
      "type": "stat",
      "title": "Avg Request Time (s)",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "wildfly_undertow_total_request_time_total_seconds / wildfly_undertow_request_count_total",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 6, "y": 9, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 2, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Worker Threads",
      "datasource": "prometheus",
      "targets": [
        { "expr": "wildfly_threads_active_count", "refId": "A" }
      ],
      "gridPos": { "x": 0, "y": 13, "w": 6, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "type": "gauge",
      "title": "Datasource Active Connections",
      "datasource": "prometheus",
      "targets": [
        { "expr": "wildfly_datasources_pool_active_count", "refId": "A" }
      ],
      "gridPos": { "x": 6, "y": 13, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 10, "color": "orange" },
              { "value": 20, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "GC Events (Young)",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "base_gc_total{name=\"G1 Young Generation\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "none" } }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"]
  }
}
